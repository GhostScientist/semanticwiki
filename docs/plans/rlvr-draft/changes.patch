new file mode 100644
index 0000000..24834d7
--- /dev/null
+++ b/src/verification/wiki-quality.ts
@@ -0,0 +1,417 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import matter from 'gray-matter';
+import { JSDOM } from 'jsdom';
+import { pipeline } from '@huggingface/transformers';
+
+export interface SourceReference {
+  raw: string;
+  filePath: string;
+  startLine: number;
+  endLine: number;
+  sourcePage: string;
+}
+
+export interface SourceReferenceCheck {
+  total: number;
+  valid: number;
+  invalid: number;
+  precision: number;
+  references: Array<SourceReference & { valid: boolean; reason?: string }>;
+}
+
+export interface StructureCheck {
+  pages: number;
+  pagesWithFrontmatter: number;
+  pagesWithTitle: number;
+  pagesWithRequiredSections: number;
+  pagesWithDuplicateH1: number;
+  emptyPages: number;
+}
+
+export interface MermaidCheck {
+  diagrams: number;
+  valid: number;
+  invalid: number;
+  diagramsChecked: Array<{ page: string; valid: boolean; reason?: string }>;
+}
+
+export interface CitationFaithfulnessCheck {
+  total: number;
+  scored: number;
+  supported: number;
+  meanSimilarity: number;
+  supportRate: number;
+  threshold: number;
+  references: Array<SourceReference & {
+    claim: string;
+    similarity?: number;
+    supported: boolean;
+    reason?: string;
+  }>;
+}
+
+export interface WikiQualityReport {
+  totalPages: number;
+  sourceReferences: SourceReferenceCheck;
+  citationFaithfulness?: CitationFaithfulnessCheck;
+  structure: StructureCheck;
+  mermaid: MermaidCheck;
+  score: number;
+}
+
+const SOURCE_REFERENCE_PATTERN =
+  /(?<![\w])((?:\.{0,2}\/)?[\w./-]+\.[A-Za-z0-9]+)(?::(\d+)(?:-(\d+))?|#L(\d+)(?:-L?(\d+))?)/g;
+const SOURCE_EXTENSIONS = new Set([
+  '.c',
+  '.cc',
+  '.cbl',
+  '.cob',
+  '.cpp',
+  '.cpy',
+  '.cs',
+  '.go',
+  '.h',
+  '.hpp',
+  '.java',
+  '.js',
+  '.jsx',
+  '.jcl',
+  '.kt',
+  '.py',
+  '.rb',
+  '.rs',
+  '.swift',
+  '.ts',
+  '.tsx'
+]);
+
+const REQUIRED_SECTIONS = ['overview', 'business context', 'related pages'];
+let mermaidPromise: Promise<typeof import('mermaid').default> | null = null;
+type FeatureExtractor = (
+  text: string,
+  options: { pooling: 'mean'; normalize: true }
+) => Promise<{ data: ArrayLike<number> }>;
+let embeddingPromise: Promise<FeatureExtractor> | null = null;
+
+async function getMermaid(): Promise<typeof import('mermaid').default> {
+  if (!mermaidPromise) {
+    mermaidPromise = (async () => {
+      const dom = new JSDOM('<!doctype html><html><body></body></html>');
+      const globals = globalThis as unknown as { window: unknown; document: unknown };
+      globals.window = dom.window;
+      globals.document = dom.window.document;
+      const mermaid = (await import('mermaid')).default;
+      mermaid.initialize({ startOnLoad: false, securityLevel: 'strict' });
+      return mermaid;
+    })();
+  }
+  return mermaidPromise;
+}
+
+async function getEmbeddingExtractor(): Promise<FeatureExtractor> {
+  if (!embeddingPromise) {
+    embeddingPromise = pipeline('feature-extraction', 'Xenova/bge-small-en-v1.5')
+      .then(extractor => extractor as unknown as FeatureExtractor);
+  }
+  return embeddingPromise;
+}
+
+function normalizeEmbedding(vector: ArrayLike<number>): number[] {
+  const values = Array.from(vector);
+  const norm = Math.sqrt(values.reduce((sum, value) => sum + value * value, 0));
+  return norm === 0 ? values : values.map(value => value / norm);
+}
+
+function cosineSimilarity(left: ArrayLike<number>, right: ArrayLike<number>): number {
+  const a = normalizeEmbedding(left);
+  const b = normalizeEmbedding(right);
+  if (a.length !== b.length) return 0;
+  return a.reduce((sum, value, index) => sum + value * b[index], 0);
+}
+
+function wikiFiles(wikiDir: string): string[] {
+  if (!fs.existsSync(wikiDir)) return [];
+
+  const files: string[] = [];
+  const visit = (directory: string): void => {
+    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+      const fullPath = path.join(directory, entry.name);
+      if (entry.isDirectory()) visit(fullPath);
+      else if (entry.isFile() && entry.name.endsWith('.md')) files.push(fullPath);
+    }
+  };
+  visit(wikiDir);
+  return files.sort();
+}
+
+function normalizeSourcePath(sourcePath: string): string {
+  return sourcePath.replace(/\\/g, '/').replace(/^\.\//, '').replace(/^(\.\.\/)+/, '');
+}
+
+function extractReferences(content: string, sourcePage: string): SourceReference[] {
+  const references: SourceReference[] = [];
+  let match: RegExpExecArray | null;
+
+  while ((match = SOURCE_REFERENCE_PATTERN.exec(content)) !== null) {
+    const rawPath = match[1];
+    if (rawPath.includes('://') || rawPath.startsWith('mailto:')) continue;
+    if (!SOURCE_EXTENSIONS.has(path.extname(rawPath).toLowerCase())) continue;
+
+    const startLine = Number(match[2] || match[4]);
+    const endLine = Number(match[3] || match[5] || startLine);
+    references.push({
+      raw: match[0],
+      filePath: normalizeSourcePath(rawPath),
+      startLine,
+      endLine,
+      sourcePage
+    });
+  }
+
+  SOURCE_REFERENCE_PATTERN.lastIndex = 0;
+  return references;
+}
+
+export function checkSourceReferences(wikiDir: string, repoDir: string): SourceReferenceCheck {
+  const references: SourceReferenceCheck['references'] = [];
+
+  for (const file of wikiFiles(wikiDir)) {
+    const page = path.relative(wikiDir, file).replace(/\\/g, '/');
+    for (const reference of extractReferences(fs.readFileSync(file, 'utf8'), page)) {
+      const resolved = path.resolve(repoDir, reference.filePath);
+      const relative = path.relative(path.resolve(repoDir), resolved);
+      let valid = true;
+      let reason: string | undefined;
+
+      if (relative.startsWith('..') || path.isAbsolute(relative)) {
+        valid = false;
+        reason = 'reference points outside the repository';
+      } else if (!fs.existsSync(resolved) || !fs.statSync(resolved).isFile()) {
+        valid = false;
+        reason = 'source file does not exist';
+      } else {
+        const lineCount = fs.readFileSync(resolved, 'utf8').split(/\r?\n/).length;
+        if (reference.startLine < 1 || reference.endLine < reference.startLine || reference.endLine > lineCount) {
+          valid = false;
+          reason = `line range is outside the file (1-${lineCount})`;
+        }
+
+      }
+
+      references.push({ ...reference, valid, reason });
+    }
+  }
+
+  const valid = references.filter(reference => reference.valid).length;
+  return {
+    total: references.length,
+    valid,
+    invalid: references.length - valid,
+    precision: references.length === 0 ? 0 : valid / references.length,
+    references
+  };
+}
+
+function claimContainingReference(content: string, reference: SourceReference): string {
+  const index = content.indexOf(reference.raw);
+  if (index < 0) return '';
+  const start = content.lastIndexOf('\n', index);
+  const nextLine = content.indexOf('\n', index + reference.raw.length);
+  const end = nextLine >= 0 ? nextLine : content.length;
+  return content
+    .slice(start + 1, end)
+    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
+    .replace(/`[^`]*`/g, '')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .slice(0, 1200);
+}
+
+export async function checkCitationFaithfulness(
+  wikiDir: string,
+  repoDir: string,
+  options: { threshold?: number; embed?: (texts: string[]) => Promise<number[][]> } = {}
+): Promise<CitationFaithfulnessCheck> {
+  const threshold = options.threshold ?? 0.45;
+  const sourceCheck = checkSourceReferences(wikiDir, repoDir);
+  const references: CitationFaithfulnessCheck['references'] = [];
+  const texts: string[] = [];
+  const pending: Array<{
+    reference: SourceReference & { valid: boolean; reason?: string };
+    claim: string;
+    source: string;
+  }> = [];
+
+  for (const reference of sourceCheck.references) {
+    const pagePath = path.resolve(wikiDir, reference.sourcePage);
+    const pageContent = fs.readFileSync(pagePath, 'utf8');
+    const claim = claimContainingReference(pageContent, reference);
+    let source = '';
+
+    if (reference.valid) {
+      const sourcePath = path.resolve(repoDir, reference.filePath);
+      source = fs.readFileSync(sourcePath, 'utf8')
+        .split(/\r?\n/)
+        .slice(reference.startLine - 1, reference.endLine)
+        .join('\n')
+        .slice(0, 2000);
+    }
+
+    const result = { ...reference, claim, supported: false };
+    if (!reference.valid) {
+      result.reason = reference.reason || 'source reference is invalid';
+      references.push(result);
+      continue;
+    }
+    if (!claim) {
+      result.reason = 'no claim text found around the reference';
+      references.push(result);
+      continue;
+    }
+
+    pending.push({ reference, claim, source });
+    texts.push(claim, source);
+  }
+
+  if (pending.length > 0) {
+    const embed = options.embed || (async (values: string[]) => {
+      const extractor = await getEmbeddingExtractor();
+      const outputs = await Promise.all(values.map(value =>
+        extractor(value, { pooling: 'mean', normalize: true })
+      ));
+      return outputs.map(output => Array.from(output.data));
+    });
+    const embeddings = await embed(texts);
+    if (embeddings.length !== texts.length) {
+      throw new Error(`Citation embedder returned ${embeddings.length} vectors for ${texts.length} texts`);
+    }
+
+    pending.forEach((item, index) => {
+      const similarity = cosineSimilarity(embeddings[index * 2], embeddings[index * 2 + 1]);
+      references.push({
+        ...item.reference,
+        claim: item.claim,
+        similarity,
+        supported: similarity >= threshold
+      });
+    });
+  }
+
+  const scored = references.filter(reference => reference.similarity !== undefined);
+  const supported = scored.filter(reference => reference.supported).length;
+  return {
+    total: references.length,
+    scored: scored.length,
+    supported,
+    meanSimilarity: scored.length === 0
+      ? 0
+      : scored.reduce((sum, reference) => sum + (reference.similarity || 0), 0) / scored.length,
+    supportRate: scored.length === 0 ? 0 : supported / scored.length,
+    threshold,
+    references
+  };
+}
+
+export function checkWikiStructure(wikiDir: string): StructureCheck {
+  const result: StructureCheck = {
+    pages: 0,
+    pagesWithFrontmatter: 0,
+    pagesWithTitle: 0,
+    pagesWithRequiredSections: 0,
+    pagesWithDuplicateH1: 0,
+    emptyPages: 0
+  };
+
+  for (const file of wikiFiles(wikiDir)) {
+    result.pages++;
+    const parsed = matter(fs.readFileSync(file, 'utf8'));
+    const content = parsed.content.trim();
+    const headings = [...content.matchAll(/^#{1,6}\s+(.+)$/gm)].map(match => ({
+      level: match[0].match(/^#+/)?.[0].length ?? 0,
+      text: match[1].trim().toLowerCase()
+    }));
+
+    if (Object.keys(parsed.data).length > 0) result.pagesWithFrontmatter++;
+    if (typeof parsed.data.title === 'string' && parsed.data.title.trim()) result.pagesWithTitle++;
+    if (REQUIRED_SECTIONS.every(section => headings.some(heading => heading.text === section))) {
+      result.pagesWithRequiredSections++;
+    }
+    if (headings.some(heading => heading.level === 1)) result.pagesWithDuplicateH1++;
+    if (!content) result.emptyPages++;
+  }
+
+  return result;
+}
+
+async function checkMermaidDiagram(
+  mermaid: typeof import('mermaid').default,
+  diagram: string
+): Promise<{ valid: boolean; reason?: string }> {
+  if (!diagram.trim()) return { valid: false, reason: 'diagram is empty' };
+  const parsed = await mermaid.parse(diagram, { suppressErrors: true });
+  return parsed
+    ? { valid: true }
+    : { valid: false, reason: 'Mermaid parser rejected the diagram' };
+}
+
+export async function checkMermaidDiagrams(wikiDir: string): Promise<MermaidCheck> {
+  const diagramsChecked: MermaidCheck['diagramsChecked'] = [];
+  const pattern = /```mermaid\s*\n([\s\S]*?)```/gi;
+  const mermaid = await getMermaid();
+
+  for (const file of wikiFiles(wikiDir)) {
+    const page = path.relative(wikiDir, file).replace(/\\/g, '/');
+    const content = fs.readFileSync(file, 'utf8');
+    let match: RegExpExecArray | null;
+    while ((match = pattern.exec(content)) !== null) {
+      try {
+        diagramsChecked.push({ page, ...(await checkMermaidDiagram(mermaid, match[1])) });
+      } catch (error) {
+        diagramsChecked.push({
+          page,
+          valid: false,
+          reason: error instanceof Error ? error.message : String(error)
+        });
+      }
+    }
+  }
+
+  pattern.lastIndex = 0;
+  const valid = diagramsChecked.filter(diagram => diagram.valid).length;
+  return {
+    diagrams: diagramsChecked.length,
+    valid,
+    invalid: diagramsChecked.length - valid,
+    diagramsChecked
+  };
+}
+
+export function calculateWikiQualityScore(
+  report: Pick<WikiQualityReport, 'sourceReferences' | 'structure' | 'mermaid'> & {
+    brokenLinks: number;
+    citationFaithfulness?: CitationFaithfulnessCheck;
+  }
+): number {
+  const sourceScore = report.sourceReferences.total === 0 ? 0 : report.sourceReferences.precision;
+  const faithfulnessScore = report.citationFaithfulness
+    ? report.citationFaithfulness.supportRate
+    : sourceScore;
+  const structureScore = report.structure.pages === 0
+    ? 0
+    : (report.structure.pagesWithFrontmatter / report.structure.pages
+      + report.structure.pagesWithTitle / report.structure.pages
+      + report.structure.pagesWithRequiredSections / report.structure.pages
+      + (1 - report.structure.pagesWithDuplicateH1 / report.structure.pages)
+      + (1 - report.structure.emptyPages / report.structure.pages)) / 5;
+  const mermaidScore = report.mermaid.diagrams === 0 ? 1 : report.mermaid.valid / report.mermaid.diagrams;
+  const linkScore = report.brokenLinks === 0 ? 1 : 0;
+
+  return Math.round((
+    sourceScore * 0.25
+    + faithfulnessScore * 0.15
+    + linkScore * 0.2
+    + structureScore * 0.25
+    + mermaidScore * 0.15
+  ) * 100);
+}
diff --git a/tests/wiki-quality.test.ts b/tests/wiki-quality.test.ts
new file mode 100644
index 0000000..8dfd818
--- /dev/null
+++ b/tests/wiki-quality.test.ts
@@ -0,0 +1,147 @@
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  calculateWikiQualityScore,
+  checkCitationFaithfulness,
+  checkMermaidDiagrams,
+  checkSourceReferences,
+  checkWikiStructure
+} from '../src/verification/index.js';
+import { appendTrajectory, promptVersion } from '../src/rlvr/trajectory.js';
+
+const temporaryDirectories: string[] = [];
+
+function createFixture(): { repoDir: string; wikiDir: string } {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'semanticwiki-quality-'));
+  temporaryDirectories.push(root);
+  const repoDir = path.join(root, 'repo');
+  const wikiDir = path.join(root, 'wiki');
+  fs.mkdirSync(path.join(repoDir, 'src'), { recursive: true });
+  fs.mkdirSync(wikiDir, { recursive: true });
+  fs.writeFileSync(path.join(repoDir, 'src', 'auth.ts'), 'export function login() {\n  return true;\n}\n');
+  return { repoDir, wikiDir };
+}
+
+afterEach(() => {
+  for (const directory of temporaryDirectories.splice(0)) fs.rmSync(directory, { recursive: true, force: true });
+});
+
+describe('wiki quality verifiers', () => {
+  it('validates source files and line ranges', () => {
+    const { repoDir, wikiDir } = createFixture();
+    fs.writeFileSync(path.join(wikiDir, 'auth.md'), [
+      '---',
+      'title: Authentication',
+      '---',
+      '',
+      'The login function is implemented in `src/auth.ts:1-3`.',
+      'A stale claim points to `src/missing.ts:1`.'
+    ].join('\n'));
+
+    const result = checkSourceReferences(wikiDir, repoDir);
+    expect(result.total).toBe(2);
+    expect(result.valid).toBe(1);
+    expect(result.precision).toBe(0.5);
+  });
+
+  it('checks required page structure without requiring an H1', () => {
+    const { wikiDir } = createFixture();
+    fs.writeFileSync(path.join(wikiDir, 'overview.md'), [
+      '---',
+      'title: Overview',
+      '---',
+      '',
+      '## Business Context',
+      'The business context.',
+      '## Overview',
+      'The overview.',
+      '## Related Pages',
+      'None.'
+    ].join('\n'));
+
+    const result = checkWikiStructure(wikiDir);
+    expect(result.pagesWithFrontmatter).toBe(1);
+    expect(result.pagesWithTitle).toBe(1);
+    expect(result.pagesWithRequiredSections).toBe(1);
+    expect(result.pagesWithDuplicateH1).toBe(0);
+  });
+
+  it('detects malformed Mermaid blocks', async () => {
+    const { wikiDir } = createFixture();
+    fs.writeFileSync(path.join(wikiDir, 'diagrams.md'), [
+      '```mermaid',
+      'flowchart LR',
+      '  A[Start] --> B[End]',
+      '```',
+      '',
+      '```mermaid',
+      'not-a-diagram',
+      '```'
+    ].join('\n'));
+
+    const result = await checkMermaidDiagrams(wikiDir);
+    expect(result.diagrams).toBe(2);
+    expect(result.valid).toBe(1);
+    expect(result.invalid).toBe(1);
+  });
+
+  it('scores citation support with an injected semantic embedder', async () => {
+    const { repoDir, wikiDir } = createFixture();
+    fs.writeFileSync(path.join(wikiDir, 'auth.md'),
+      'The login function returns true when authentication succeeds (`src/auth.ts:1-3`).\n');
+
+    const result = await checkCitationFaithfulness(wikiDir, repoDir, {
+      threshold: 0.8,
+      embed: async texts => texts.map(text =>
+        text.includes('export') ? [0, 1] : [1, 0]
+      )
+    });
+    expect(result.total).toBe(1);
+    expect(result.scored).toBe(1);
+    expect(result.supported).toBe(0);
+    expect(result.meanSimilarity).toBe(0);
+  });
+
+  it('combines verifier components into a bounded score', () => {
+    const score = calculateWikiQualityScore({
+      brokenLinks: 0,
+      sourceReferences: { total: 2, valid: 2, invalid: 0, precision: 1, references: [] },
+      structure: {
+        pages: 1,
+        pagesWithFrontmatter: 1,
+        pagesWithTitle: 1,
+        pagesWithRequiredSections: 1,
+        pagesWithDuplicateH1: 0,
+        emptyPages: 0
+      },
+      mermaid: { diagrams: 0, valid: 0, invalid: 0, diagramsChecked: [] }
+    });
+    expect(score).toBe(100);
+  });
+
+  it('writes one self-contained trajectory record per JSONL line', async () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'semanticwiki-trajectory-'));
+    temporaryDirectories.push(root);
+    const filePath = path.join(root, 'runs', 'trajectories.jsonl');
+    await appendTrajectory(filePath, {
+      schemaVersion: 1,
+      harnessVersion: '0.1.0',
+      promptVersion: promptVersion('system prompt'),
+      runId: 'run-1',
+      createdAt: '2026-01-01T00:00:00.000Z',
+      status: 'completed',
+      mode: 'local',
+      model: 'test-model',
+      repoUrl: './repo',
+      outputDir: './wiki',
+      tools: [],
+      turns: []
+    });
+
+    const lines = fs.readFileSync(filePath, 'utf8').trim().split('\n');
+    expect(lines).toHaveLength(1);
+    expect(JSON.parse(lines[0]).runId).toBe('run-1');
+  });
+});
