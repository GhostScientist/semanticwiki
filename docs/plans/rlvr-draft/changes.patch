+++ b/src/rlvr/trajectory.ts
@@ -0,0 +1,51 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { createHash } from 'crypto';
+import type { LLMTool } from '../llm/types.js';
+import type { WikiQualityReport } from '../verification/index.js';
+
+export const TRAJECTORY_SCHEMA_VERSION = 1;
+export const HARNESS_VERSION = '0.1.0';
+
+export interface TrajectoryToolCall {
+  id: string;
+  name: string;
+  arguments: Record<string, unknown>;
+  result: string;
+  isError: boolean;
+}
+
+export interface TrajectoryTurn {
+  turn: number;
+  assistantContent: string;
+  stopReason: string;
+  usage: { inputTokens: number; outputTokens: number };
+  toolCalls: TrajectoryToolCall[];
+}
+
+export interface TrajectoryRecord {
+  schemaVersion: number;
+  harnessVersion: string;
+  promptVersion: string;
+  runId: string;
+  createdAt: string;
+  status: 'completed' | 'failed';
+  mode: 'direct-api' | 'local';
+  model: string;
+  repoUrl: string;
+  outputDir: string;
+  tools: LLMTool[];
+  turns: TrajectoryTurn[];
+  quality?: WikiQualityReport & { brokenLinks: number };
+  error?: string;
+}
+
+export function promptVersion(prompt: string): string {
+  return createHash('sha256').update(prompt).digest('hex').slice(0, 16);
+}
+
+export async function appendTrajectory(filePath: string, record: TrajectoryRecord): Promise<void> {
+  const resolvedPath = path.resolve(filePath);
+  await fs.promises.mkdir(path.dirname(resolvedPath), { recursive: true });
+  await fs.promises.appendFile(resolvedPath, `${JSON.stringify(record)}\n`, 'utf8');
+}
